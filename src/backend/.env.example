# Copy to .env and export, or set in your shell. All optional.
REID_MODEL=dummy            # dummy | convnext | miewid
REID_DEVICE=cpu             # cpu | cuda
REID_CHECKPOINT=            # path to fine-tuned backbone weights
REID_SCORE=                 # max_sim | margin; empty = the score chosen in the exported gallery
REID_THRESHOLD=             # open-set threshold tau; empty = the validated threshold in the exported gallery
REID_TOP_K=5
REID_MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173
