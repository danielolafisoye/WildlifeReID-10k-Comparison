# Copy to .env and export, or set these values in your shell.
REID_DEFAULT_MODEL=convnext
REID_DEVICE=auto            # auto | cpu | cuda | mps
CONVNEXT_CHECKPOINT=../models/convnext/convnext_weights.pth
CONVNEXT_LABEL_MAP=../models/convnext/label_map.json
WILDLIFE_DATASET_ROOT=../../data/wildlifereid-10k
WILDLIFE_DATASET_ARCHIVE=../../data/archive.zip
WILDLIFE_KAGGLE_DATASET=wildlifedatasets/wildlifereid-10k/versions/10
WILDLIFE_KAGGLE_ON_DEMAND=true
REID_THRESHOLD=0.50
REID_TOP_K=5
REID_UNKNOWN_TEST_IDENTITIES=20
REID_MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
