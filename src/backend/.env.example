# Copy to .env and export, or set in your shell. All optional.
REID_MODEL=dummy            # dummy | convnext | miewid
REID_DEVICE=cpu             # cpu | cuda
REID_CHECKPOINT=            # path to fine-tuned backbone weights
REID_THRESHOLD=0.65         # open-set threshold tau (tune on validation data)
REID_TOP_K=5
REID_MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173
